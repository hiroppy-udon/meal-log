# Copy this file to .env.local and fill in the two values.
# .env.local is listed in .gitignore and never reaches the repository.
#
# Both come from the Supabase dashboard:
#   Project Settings -> API
#
# The same two values also go into Vercel, under
#   Project Settings -> Environment Variables
# otherwise the deployed app has nothing to connect to.
#
# Vite only exposes variables whose name starts with VITE_ to the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
